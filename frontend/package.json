{
  "name": "salad-delivery-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "expo": "~57.0.18",
    "expo-location": "~57.0.14",
    "expo-print": "~57.0.1",
    "expo-sharing": "~57.0.16",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:admin": "EXPO_PUBLIC_APP_VARIANT=admin expo start",
    "start:customer": "EXPO_PUBLIC_APP_VARIANT=customer expo start",
    "start:driver": "EXPO_PUBLIC_APP_VARIANT=driver expo start",
    "android": "expo run:android",
    "android:driver": "EXPO_PUBLIC_APP_VARIANT=driver expo run:android",
    "ios": "expo run:ios",
    "ios:driver": "EXPO_PUBLIC_APP_VARIANT=driver expo run:ios",
    "web": "expo start --web",
    "web:admin": "EXPO_PUBLIC_APP_VARIANT=admin expo start --web",
    "web:customer": "EXPO_PUBLIC_APP_VARIANT=customer expo start --web",
    "web:driver": "EXPO_PUBLIC_APP_VARIANT=driver expo start --web",
    "export:web": "expo export --platform web",
    "export:web:admin": "EXPO_PUBLIC_APP_VARIANT=admin expo export --platform web",
    "export:web:driver": "EXPO_PUBLIC_APP_VARIANT=driver expo export --platform web"
  },
  "private": true
}
