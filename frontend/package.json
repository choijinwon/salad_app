{
  "name": "salad-delivery-ionic",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@ionic/react": "^8.8.8",
    "@ionic/react-router": "^8.8.8",
    "ionicons": "^8.0.13",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@ionic/cli": "^7.2.1",
    "@types/react": "~19.2.2",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "typescript": "~6.0.3",
    "vite": "^7.3.0"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "build:customer": "VITE_APP_VARIANT=customer npm run build",
    "build:driver": "VITE_APP_VARIANT=driver npm run build",
    "icons:customer": "python3 scripts/generate_variant_icons.py customer",
    "icons:driver": "python3 scripts/generate_variant_icons.py driver",
    "apk:customer": "bash scripts/build_android_variant.sh customer",
    "apk:driver": "bash scripts/build_android_variant.sh driver",
    "apk:all": "npm run apk:customer && npm run apk:driver",
    "ionic:serve": "vite --host 127.0.0.1",
    "ionic:build": "npm run build",
    "serve:ionic": "IONIC_CONFIG_DIRECTORY=.ionic ionic serve --host=127.0.0.1",
    "build:ionic": "IONIC_CONFIG_DIRECTORY=.ionic ionic build",
    "sync:ionic": "npm run build && cap sync",
    "ios:ionic": "npm run build && cap sync ios && cap open ios",
    "android:ionic": "npm run build && cap sync android && cap open android",
    "preview": "vite preview --host 127.0.0.1",
    "ios": "npm run build && cap sync ios && cap open ios",
    "android": "npm run build && cap sync android && cap open android",
    "cap:sync": "cap sync"
  },
  "private": true
}
